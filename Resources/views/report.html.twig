{% extends 'reporting/layout.html.twig' %}

{# Durations are pre-formatted in PHP (MissingHoursRow::formatDuration): Twig
   macros imported in a block are out of scope inside `{% embed %}`, and with
   strict_variables off that fails silently with empty cells. #}

{% block report %}
    {% from '@theme/components/alert.html.twig' import alert %}

    {% if error %}
        {{ alert({type: 'danger', important: true, description: error|trans}) }}
    {% endif %}

    {% embed '@theme/embeds/card.html.twig' %}
        {% block box_title %}{{ 'missing_hours.period'|trans }}{% endblock %}
        {% block box_body %}
            <form method="get" action="{{ path('missing_hours_report') }}" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label" for="mh_from">{{ 'missing_hours.from'|trans }}</label>
                    <input class="form-control" id="mh_from" type="date" name="from" value="{{ period.from|date('Y-m-d') }}" required>
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="mh_to">{{ 'missing_hours.to'|trans }}</label>
                    <input class="form-control" id="mh_to" type="date" name="to" value="{{ period.to|date('Y-m-d') }}" required>
                </div>
                <div class="col-md-3">
                    <label class="form-check">
                        <input class="form-check-input" type="checkbox" name="all" value="1" {{ only_missing ? '' : 'checked' }}>
                        <span class="form-check-label">{{ 'missing_hours.include_up_to_date'|trans }}</span>
                    </label>
                </div>
                <div class="col-md-3 btn-list justify-content-end">
                    <button type="submit" class="btn btn-primary">{{ 'missing_hours.show'|trans }}</button>
                    <a class="btn" href="{{ path('missing_hours_report_export', {from: period.from|date('Y-m-d'), to: period.to|date('Y-m-d'), all: only_missing ? null : '1'}) }}">{{ 'csv'|trans }}</a>
                </div>
            </form>
            <div class="btn-list mt-3">
                {% for label, preset in presets %}
                    <a class="btn btn-sm btn-outline-secondary" href="{{ path('missing_hours_report', {from: preset.from|date('Y-m-d'), to: preset.to|date('Y-m-d')}) }}">{{ label|trans }}</a>
                {% endfor %}
            </div>
        {% endblock %}
    {% endembed %}

    <div class="row row-cards mb-3">
        <div class="col-md-4">
            <div class="card card-sm"><div class="card-body">
                <div class="text-secondary">{{ 'missing_hours.stats.users_below'|trans }}</div>
                <div class="h2 m-0">{{ missing_count }}</div>
            </div></div>
        </div>
        <div class="col-md-4">
            <div class="card card-sm"><div class="card-body">
                <div class="text-secondary">{{ 'missing_hours.stats.total_missing'|trans }}</div>
                <div class="h2 m-0">{{ total_missing }}</div>
            </div></div>
        </div>
        <div class="col-md-4">
            <div class="card card-sm"><div class="card-body">
                <div class="text-secondary">{{ 'missing_hours.stats.average_missing'|trans }}</div>
                <div class="h2 m-0">{{ average_missing }}</div>
            </div></div>
        </div>
    </div>

    {% embed '@theme/embeds/card.html.twig' with {'fullsize': true} %}
        {% block box_title %}{{ period.from|date_short }} – {{ period.to|date_short }}{% endblock %}
        {% block box_body_class %}p-0{% endblock %}
        {% block box_body %}
            {% if rows|length == 0 %}
                <div class="p-3 text-success">{{ 'missing_hours.report.empty'|trans }}</div>
            {% else %}
                <table class="table table-vcenter card-table dataTable">
                    <thead>
                        <tr>
                            <th>{{ 'user'|trans }}</th>
                            <th class="d-none d-md-table-cell">{{ 'email'|trans }}</th>
                            <th class="text-end">{{ 'missing_hours.expected'|trans }}</th>
                            <th class="text-end">{{ 'missing_hours.actual'|trans }}</th>
                            <th class="text-end">{{ 'missing_hours.difference'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in rows %}
                            <tr>
                                <td>{{ row.user.displayName }}</td>
                                <td class="d-none d-md-table-cell">{{ row.user.email }}</td>
                                <td class="text-end">{{ row.expectedFormatted }}</td>
                                <td class="text-end">{{ row.actualFormatted }}</td>
                                <td class="text-end">
                                    <span class="badge {{ row.missing ? 'bg-red-lt' : 'bg-green-lt' }}">{{ row.differenceFormatted }}</span>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        {% endblock %}
    {% endembed %}

    <p class="text-secondary small">
        {{ 'missing_hours.report.footnote'|trans({'%page%': 'work_times'|trans}) }}
    </p>
{% endblock %}
